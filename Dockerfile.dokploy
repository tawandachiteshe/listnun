# Builds listnun from source (the repo's Dockerfile expects a prebuilt binary from goreleaser).
# Stage 1: Go + Node + yarn, then `make dist` (frontend, email builder, Go binary, assets packed in).
FROM node:22-bookworm AS build
COPY --from=golang:1.26-bookworm /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH \
    CGO_ENABLED=0 \
    GOFLAGS=-buildvcs=false
RUN apt-get update && apt-get install -y --no-install-recommends make git && rm -rf /var/lib/apt/lists/* \
 && corepack enable
WORKDIR /src
COPY . .
# .dockerignore leaves out every .gitignore, but the frontend's prebuild lint reads frontend/.gitignore
# (--ignore-path) to skip the generated API client. Recreate the rules that matter.
RUN printf 'node_modules\n/dist\nsrc/api/generated/\n/coverage/\n' > frontend/.gitignore \
 && touch frontend/email-builder/.gitignore \
 && make dist

# Stage 2: the same small runtime image as the repo's Dockerfile.
FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata shadow su-exec
WORKDIR /listnun
COPY --from=build /src/listnun .
COPY config.toml.sample config.toml
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 9000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["sh", "-c", "./listnun --install --idempotent --yes --config '' && ./listnun --upgrade --yes --config '' && ./listnun --config ''"]
